{
  "name": "power-praesentation",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.1.0",
  "scripts": {
    "dev": "pnpm --filter @power/web dev",
    "build": "pnpm --filter @power/web build",
    "start": "pnpm --filter @power/web start",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @power/shared test && pnpm --filter @power/contracts test",
    "test:e2e": "pnpm --filter @power/web test:e2e",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/node": "^22.10.7",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
